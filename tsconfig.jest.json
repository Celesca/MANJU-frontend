{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": ["node", "jest", "@testing-library/jest-dom", "vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src", "__tests__"]
}
