# Edit these values as needed
# DATABASE_URL example for Postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/manju_dev?sslmode=disable
## If you run Postgres via Docker Compose in this repository from the `server/` folder
## you can connect using the service host name `db`, e.g.
## DATABASE_URL=postgres://postgres:postgres@db:5432/manju_dev?sslmode=disable
PORT=3000

# F5-TTS-THAI-API Service URL (for voice cloning)
# Use 127.0.0.1 instead of localhost to avoid IPv6 issues on Windows
F5_TTS_SERVICE_URL=http://127.0.0.1:8000

# Azure Blob Storage (optional - falls back to local storage if not set)
# Run: backend/scripts/setup-azure-storage.bat to create the storage account
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=voices
