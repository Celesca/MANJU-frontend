# ==============================================================
# Backend Service Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Frontend URL for CORS + OAuth redirect back target
FRONTEND_URL=http://localhost:5173

# -------------------------
# Database (PostgreSQL)
# -------------------------
# Use DB_HOST=db when running backend + db in docker-compose.
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=manju_dev
SSL_MODE=disable

# -------------------------
# Security / Auth
# -------------------------
# Shared API key required by middleware/API proxy calls.
# Must match frontend VITE_MANJU_API_KEY and ai_backend MANJU_API_KEY.
MANJU_API_KEY=your_manju_api_key_here

# Encryption / JWT keys (use strong random values in production)
ENCRYPTION_KEY=replace_with_hex_or_strong_secret
JWT_SECRET=replace_with_strong_jwt_secret

# Google OAuth settings
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REDIRECT_URI=http://localhost:8080/auth/callback/google
# Optional alias used in auth fallback logic
OAUTH_REDIRECT_URL=

# Optional local-dev bypass
DISABLE_AUTH=false
DEV_USER_ID=

# -------------------------
# External Services
# -------------------------
# AI backend base URL (now expected to be external, e.g. Colab + tunnel)
AI_SERVICE_URL=http://host.docker.internal:8000

# Legacy/voice clone service endpoint (if used)
F5_TTS_SERVICE_URL=http://127.0.0.1:8000

# -------------------------
# Storage (optional)
# -------------------------
# Local fallback paths
VOICES_STORAGE_PATH=./uploads/voices
DOCUMENTS_STORAGE_PATH=./uploads/documents

# Azure Blob Storage (optional)
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
# AZURE_STORAGE_CONTAINER=voices
