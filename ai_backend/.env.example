# ==============================================================
# AI Backend Environment Variables (main.py + qwen3_tts.py)
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# -------------------------
# Service Ports
# -------------------------
# main.py service port
AI_SERVICE_PORT=8000

# qwen3_tts.py service port (if launched separately)
QWEN_TTS_PORT=8001

# -------------------------
# Security
# -------------------------
# Shared API key checked by AI services.
# Must match frontend/backend equivalents.
MANJU_API_KEY=your_manju_api_key_here

# -------------------------
# LLM Providers
# -------------------------
OPENAI_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# Optional extra keys used in some local/testing scripts
OPENAI_API_KEY_2=
TYPHOON_API_KEY=
ELEVENLABS_API_KEY=

# -------------------------
# Qwen3 TTS Integration
# -------------------------
# URL used by main.py to call qwen3_tts.py
QWEN_TTS_URL=http://localhost:8001

# Model preloaded by qwen3_tts.py at startup: base | custom | design
QWEN_TTS_PRELOAD_MODEL=custom

# -------------------------
# Tooling / Data Sources
# -------------------------
# Optional Google Sheets service account file path
GOOGLE_SHEETS_CREDENTIALS=client_secret.json

# Local docs/index paths used by RAG
DOCUMENTS_STORAGE_PATH=../backend/uploads/documents
FAISS_INDEX_PATH=./faiss_indexes
