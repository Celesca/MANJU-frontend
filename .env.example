# ==============================================================
# Frontend (Vite) Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# Backend API base URL
# Local Docker/backend default:
VITE_API_URL=http://localhost:8080

# Shared API key passed as X-API-Key from frontend requests
# Must match MANJU_API_KEY configured on backend/ai services.
VITE_MANJU_API_KEY=your_manju_api_key_here

# Docker Compose interpolation variable (used by docker-compose.yml)
# Point this to your external AI backend (e.g. Colab tunnel URL).
# Example: https://xxxx-xx-xx-xx-xx.ngrok-free.app
AI_SERVICE_URL=http://host.docker.internal:8000
